{
   suppress_readline_and_tinfo_memory
   Memcheck:Leak
   fun:malloc
   ...
   fun:readline
}

{
   suppress_readline_and_tinfo_memory_realloc
   Memcheck:Leak
   fun:realloc
   ...
   fun:readline
}

{
   suppress_readline_and_tinfo_memory_calloc
   Memcheck:Leak
   fun:calloc
   ...
   fun:readline
}

